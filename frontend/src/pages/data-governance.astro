---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import PipelineDiagram from '../components/PipelineDiagram.astro';

const etlSteps = [
  { name: 'Extract', desc: 'Lectura de datos crudos desde OBS (CSV, JSON, PDFs)', status: 'complete', icon: '📥' },
  { name: 'Transform', desc: 'Limpieza, normalización CNBV, deduplicación', status: 'complete', icon: '🔄' },
  { name: 'Validate', desc: 'Reglas de calidad: nulos, rangos, consistencia', status: 'complete', icon: '✅' },
  { name: 'Load', desc: 'Escritura a DWS con particionamiento por fecha', status: 'complete', icon: '📤' },
  { name: 'Publish', desc: 'DataService API REST con cache y rate limiting', status: 'active', icon: '🌐' },
];
---

<BaseLayout title="Data Governance" description="Arquitectura en capas ODS → DW → DM con DWS y DLI — Gobernanza de datos">
  <Header slot="header" />

  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-emerald-800 to-emerald-600 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center space-x-2 mb-4">
        <a href="/" class="text-emerald-200 hover:text-white text-sm">Inicio</a>
        <span class="text-emerald-400">/</span>
        <span class="text-sm text-emerald-200">Demo 2</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold mb-2">Data Governance</h1>
      <p class="text-lg text-emerald-100">Arquitectura en capas ODS → DW → DM con DWS, DLI Spark y Langfuse.</p>
    </div>
  </section>

  <!-- Pipeline -->
  <section class="bg-white border-b border-gs-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <h2 class="text-sm font-semibold text-gs-gray-600 uppercase tracking-wider mb-4">Arquitectura en Capas — ODS → DW → DM</h2>
      <PipelineDiagram variant="governance" />
    </div>
  </section>

  <!-- ETL Steps -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <h2 class="section-title mb-8">Etapas del Pipeline</h2>
    <div class="space-y-4 stagger-children">
      {etlSteps.map((step, i) => (
        <div class="card p-5 flex items-center space-x-5">
          <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-2xl flex-shrink-0">
            {step.icon}
          </div>
          <div class="flex-1">
            <div class="flex items-center space-x-3">
              <span class="text-xs font-bold text-gs-gray-400">PASO {i + 1}</span>
              <h3 class="text-lg font-bold text-gs-navy">{step.name}</h3>
              <span class={`text-xs px-2 py-0.5 rounded-full font-semibold ${
                step.status === 'complete'
                  ? 'bg-emerald-100 text-emerald-700'
                  : 'bg-gs-blue/10 text-gs-blue animate-pulse-soft'
              }`}>
                {step.status === 'complete' ? 'Completado' : 'Activo'}
              </span>
            </div>
            <p class="text-sm text-gs-gray-600 mt-1">{step.desc}</p>
          </div>
          <div class="hidden md:flex items-center">
            {step.status === 'complete' ? (
              <svg class="w-6 h-6 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            ) : (
              <div class="w-6 h-6 rounded-full border-2 border-gs-blue border-t-transparent animate-spin"/>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- DWS Layered Architecture -->
  <section class="bg-white py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-title mb-2">DWS — Arquitectura en Capas</h2>
      <p class="section-subtitle mb-8">Los datos 'maduran' de crudos (ODS) a analíticos (DM). Cada capa agrega validación y transformación.</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger-children">
        <!-- ODS -->
        <div class="card p-6 border-l-4 border-amber-500">
          <div class="flex items-center space-x-2 mb-3">
            <span class="text-2xl">📥</span>
            <h3 class="text-lg font-bold text-gs-navy">ODS — Datos Crudos</h3>
          </div>
          <p class="text-sm text-gs-gray-600 mb-4">Ingesta directa desde fuentes. Sin transformación. Auditoría de origen.</p>
          <div class="space-y-2">
            <div class="flex justify-between text-sm">
              <span class="text-gs-gray-500">vendors</span>
              <span class="font-mono text-gs-navy">2,300 registros</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gs-gray-500">customers</span>
              <span class="font-mono text-gs-navy">500 registros</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gs-gray-500">transactions</span>
              <span class="font-mono text-gs-navy">5,000 registros</span>
            </div>
          </div>
        </div>

        <!-- DW -->
        <div class="card p-6 border-l-4 border-yellow-500">
          <div class="flex items-center space-x-2 mb-3">
            <span class="text-2xl">🔄</span>
            <h3 class="text-lg font-bold text-gs-navy">DW — Esquema Estrella</h3>
          </div>
          <p class="text-sm text-gs-gray-600 mb-4">Limpieza, deduplicación, normalización. Dimensiones + hechos.</p>
          <div class="space-y-2">
            <div class="flex justify-between text-sm">
              <span class="text-gs-gray-500">dim_vendor</span>
              <span class="font-mono text-gs-navy">2,300 registros</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gs-gray-500">dim_customer</span>
              <span class="font-mono text-gs-navy">500 registros</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gs-gray-500">fact_transaction</span>
              <span class="font-mono text-gs-navy">5,000 registros</span>
            </div>
          </div>
        </div>

        <!-- DM -->
        <div class="card p-6 border-l-4 border-emerald-500">
          <div class="flex items-center space-x-2 mb-3">
            <span class="text-2xl">📈</span>
            <h3 class="text-lg font-bold text-gs-navy">DM — Vistas Analíticas</h3>
          </div>
          <p class="text-sm text-gs-gray-600 mb-4">Agregaciones pre-calculadas para dashboards y reportes ejecutivos.</p>
          <div class="space-y-2">
            <div class="flex justify-between text-sm">
              <span class="text-gs-gray-500">vendor_risk_summary</span>
              <span class="font-mono text-gs-navy">15 proveedores</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gs-gray-500">city_risk</span>
              <span class="font-mono text-gs-navy">32 estados</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gs-gray-500">anomaly_summary</span>
              <span class="font-mono text-gs-navy">patrones CNBV</span>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA to Streamlit -->
      <div class="mt-8 text-center">
        <a href="http://101.44.185.139:8501" target="_blank" rel="noopener"
           class="inline-flex items-center px-6 py-3 bg-emerald-600 text-white rounded-xl hover:bg-emerald-700 transition-colors font-semibold">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          Abrir Dashboard Interactivo →
        </a>
        <p class="text-xs text-gs-gray-400 mt-2">Streamlit con queries en vivo a DWS — Data Quality + Governance tabs</p>
      </div>
    </div>
  </section>

  <!-- Data Quality Metrics -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <h2 class="section-title mb-8">Métricas de Calidad de Datos</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 stagger-children">
      {[
        { label: 'Completitud', value: '98.7%', desc: 'Campos no nulos vs total', color: 'bg-emerald-500' },
        { label: 'Consistencia', value: '99.2%', desc: 'Reglas de negocio válidas', color: 'bg-emerald-500' },
        { label: 'Freshness', value: '<5min', desc: 'Latencia de datos actualizados', color: 'bg-gs-blue' },
      ].map((m) => (
        <div class="card p-6">
          <p class="metric-label mb-1">{m.label}</p>
          <p class="metric-value">{m.value}</p>
          <p class="text-sm text-gs-gray-600 mt-1">{m.desc}</p>
          <div class="mt-4 h-2 bg-gs-gray-100 rounded-full overflow-hidden">
            <div class={`h-full ${m.color} rounded-full`} style={`width: ${m.value.includes('%') ? m.value : '85%'}`}/>
          </div>
        </div>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
  <ChatWidget />
</BaseLayout>
