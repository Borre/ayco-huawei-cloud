---
// ChatWidget: connects to Dify API with SSE streaming
// Positioned fixed bottom-right on all pages
// States: closed (bubble only), open (full window)
// Features: minimize button, notification badge, smooth animations
---

<!-- Chat Toggle Button -->
<div class="chat-widget" id="chat-widget">
  <button class="chat-bubble" id="chat-toggle" aria-label="Abrir chat">
    <svg id="chat-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
    </svg>
    <svg id="chat-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
    <span class="chat-badge hidden" id="chat-badge">1</span>
  </button>

  <!-- Chat Window -->
  <div class="chat-window chat-window-closed" id="chat-window">
    <!-- Header -->
    <div class="bg-gs-navy text-white p-4 flex items-center space-x-3 rounded-t-3xl">
      <div class="w-8 h-8 rounded-full bg-gs-gold/20 flex items-center justify-center">
        <svg class="w-4 h-4 text-gs-gold" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v-2h2v2zm0-4H9V5h2v4z"/>
        </svg>
      </div>
      <div>
        <p class="text-sm font-semibold">AYCO — Asistente de Contratos</p>
        <p class="text-xs text-gs-gray-300" id="chat-status">En línea</p>
      </div>
      <div class="ml-auto flex items-center space-x-1">
        <button id="chat-minimize" class="p-2 text-gs-gray-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors" title="Minimizar">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
          </svg>
        </button>
        <button id="chat-clear" class="p-2 text-gs-gray-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors" title="Nueva conversación">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Messages -->
    <div class="chat-messages" id="chat-messages">
      <div class="flex items-start space-x-2 animate-fade-in">
        <div class="w-7 h-7 rounded-full bg-gs-navy flex items-center justify-center flex-shrink-0">
          <span class="text-xs text-gs-gold font-bold">A</span>
        </div>
        <div class="bg-gs-gray-100 rounded-2xl rounded-tl-md px-4 py-2.5 max-w-[85%]">
          <p class="text-sm text-gs-gray-900">
            Hola, soy el asistente de análisis de contratos de AYCO. Puedo ayudarte a evaluar riesgos, consultar términos contractuales y analizar cláusulas. ¿En qué te puedo ayudar?
          </p>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="px-4 pb-2 flex flex-wrap gap-1.5" id="quick-actions">
      <button class="quick-action text-xs px-3 py-1.5 bg-gs-blue/10 text-gs-blue rounded-full hover:bg-gs-blue/20 transition-colors" data-query="Analiza el contrato AYCO-2026-0147">
        Analizar contrato alto riesgo
      </button>
      <button class="quick-action text-xs px-3 py-1.5 bg-gs-blue/10 text-gs-blue rounded-full hover:bg-gs-blue/20 transition-colors" data-query="¿Cuáles son los proveedores con mayor riesgo?">
        Top proveedores riesgo
      </button>
      <button class="quick-action text-xs px-3 py-1.5 bg-gs-blue/10 text-gs-blue rounded-full hover:bg-gs-blue/20 transition-colors" data-query="Resumen ejecutivo de la exposición actual">
        Resumen ejecutivo
      </button>
    </div>

    <!-- Input -->
    <div class="chat-input-area">
      <form id="chat-form" class="flex items-center space-x-2">
        <input
          type="text"
          id="chat-input"
          placeholder="Escribe tu pregunta..."
          class="flex-1 px-4 py-2.5 text-sm border border-gs-gray-200 rounded-xl focus:outline-none focus:border-gs-blue focus:ring-1 focus:ring-gs-blue/30 transition-colors"
          autocomplete="off"
        />
        <button type="submit" id="chat-send" class="w-10 h-10 bg-gs-blue text-white rounded-xl hover:bg-gs-blue-light transition-colors flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  const DIFY_BASE = '/api/dify';
  const DIFY_KEY = import.meta.env.PUBLIC_DIFY_API_KEY || 'app-xxxxxxxxxxxxxxxx';

  let conversationId = '';
  let isStreaming = false;
  let chatOpen = false;

  const widget = document.getElementById('chat-widget');
  const toggle = document.getElementById('chat-toggle');
  const window_ = document.getElementById('chat-window');
  const messages = document.getElementById('chat-messages');
  const form = document.getElementById('chat-form');
  const input = document.getElementById('chat-input');
  const sendBtn = document.getElementById('chat-send');
  const clearBtn = document.getElementById('chat-clear');
  const minimizeBtn = document.getElementById('chat-minimize');
  const iconOpen = document.getElementById('chat-icon-open');
  const iconClose = document.getElementById('chat-icon-close');
  const statusEl = document.getElementById('chat-status');
  const quickActions = document.getElementById('quick-actions');
  const badge = document.getElementById('chat-badge');

  function openChat() {
    chatOpen = true;
    window_?.classList.remove('chat-window-closed');
    window_?.classList.add('chat-window-open');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    badge?.classList.add('hidden');
    widget?.classList.remove('chat-pulse');
    setTimeout(() => input?.focus(), 300);
  }

  function closeChat() {
    chatOpen = false;
    window_?.classList.remove('chat-window-open');
    window_?.classList.add('chat-window-closed');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  toggle?.addEventListener('click', () => {
    if (chatOpen) {
      closeChat();
    } else {
      openChat();
    }
  });

  minimizeBtn?.addEventListener('click', () => {
    closeChat();
  });

  // Notification badge appears after 3 seconds
  setTimeout(() => {
    if (!chatOpen && badge) {
      badge.classList.remove('hidden');
    }
  }, 3000);

  // Subtle pulse on bubble when closed
  widget?.classList.add('chat-pulse');

  clearBtn?.addEventListener('click', () => {
    conversationId = '';
    if (messages) {
      messages.innerHTML = `
        <div class="flex items-start space-x-2 animate-fade-in">
          <div class="w-7 h-7 rounded-full bg-gs-navy flex items-center justify-center flex-shrink-0">
            <span class="text-xs text-gs-gold font-bold">A</span>
          </div>
          <div class="bg-gs-gray-100 rounded-2xl rounded-tl-md px-4 py-2.5 max-w-[85%]">
            <p class="text-sm text-gs-gray-900">Conversación reiniciada. ¿En qué te puedo ayudar?</p>
          </div>
        </div>
      `;
    }
  });

  quickActions?.querySelectorAll('.quick-action').forEach(btn => {
    btn.addEventListener('click', () => {
      const query = btn.getAttribute('data-query');
      if (query && input) {
        input.value = query;
        form?.dispatchEvent(new Event('submit'));
      }
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const query = (input as HTMLInputElement)?.value?.trim();
    if (!query || isStreaming) return;

    appendMessage(query, 'user');
    (input as HTMLInputElement).value = '';
    isStreaming = true;
    sendBtn?.setAttribute('disabled', 'true');
    if (statusEl) statusEl.textContent = 'Escribiendo...';

    const assistantDiv = appendMessage('', 'assistant', true);

    try {
      const response = await fetch(`${DIFY_BASE}/chat-messages`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${DIFY_KEY}`,
        },
        body: JSON.stringify({
          inputs: {},
          query,
          response_mode: 'streaming',
          conversation_id: conversationId,
          user: 'demo-workshop',
        }),
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}`);
      }

      const reader = response.body?.getReader();
      const decoder = new TextDecoder();
      let buffer = '';
      let fullAnswer = '';

      if (reader) {
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split('\n');
          buffer = lines.pop() || '';

          for (const line of lines) {
            if (!line.startsWith('data: ')) continue;
            try {
              const data = JSON.parse(line.slice(6));
              if (data.event === 'agent_message' || data.event === 'message') {
                fullAnswer += data.answer || '';
                if (assistantDiv) {
                  const p = assistantDiv.querySelector('p');
                  if (p) p.textContent = fullAnswer;
                }
              }
              if (data.conversation_id) {
                conversationId = data.conversation_id;
              }
            } catch {}
          }
        }
      }

      assistantDiv?.querySelector('p')?.classList.remove('streaming-cursor');

    } catch (err) {
      if (assistantDiv) {
        const p = assistantDiv.querySelector('p');
        if (p) p.textContent = 'Error al conectar con el servicio. Intenta de nuevo.';
        p?.classList.add('text-risk-high');
      }
    } finally {
      isStreaming = false;
      sendBtn?.removeAttribute('disabled');
      if (statusEl) statusEl.textContent = 'En línea';
      messages?.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
    }
  });

  function appendMessage(text: string, role: string, streaming = false) {
    const div = document.createElement('div');
    div.className = 'flex items-start space-x-2 animate-fade-in';

    if (role === 'user') {
      div.innerHTML = `
        <div class="flex-1 flex justify-end">
          <div class="bg-gs-blue text-white rounded-2xl rounded-tr-md px-4 py-2.5 max-w-[85%]">
            <p class="text-sm">${escapeHtml(text)}</p>
          </div>
        </div>
      `;
    } else {
      div.innerHTML = `
        <div class="w-7 h-7 rounded-full bg-gs-navy flex items-center justify-center flex-shrink-0">
          <span class="text-xs text-gs-gold font-bold">A</span>
        </div>
        <div class="bg-gs-gray-100 rounded-2xl rounded-tl-md px-4 py-2.5 max-w-[85%]">
          <p class="text-sm text-gs-gray-900 ${streaming ? 'streaming-cursor' : ''}">${text || '...'}</p>
        </div>
      `;
    }

    messages?.appendChild(div);
    messages?.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
    return div;
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }
</script>
