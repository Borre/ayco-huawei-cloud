---
// Header with Grupo Salinas branding
---

<header class="bg-gs-navy text-white sticky top-0 z-40 shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3">
        <div class="flex items-center">
          <svg viewBox="0 0 40 40" class="w-9 h-9" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="18" stroke="#C5A55A" stroke-width="2.5" fill="none"/>
            <text x="20" y="25" text-anchor="middle" fill="#C5A55A" font-family="Inter" font-weight="700" font-size="14">GS</text>
          </svg>
          <div class="ml-3">
            <div class="text-sm font-semibold text-gs-gold tracking-wide">GRUPO SALINAS</div>
            <div class="text-xs text-gs-gray-300 -mt-0.5">Aplicaciones y Cobranza</div>
          </div>
        </div>
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center space-x-1">
        <a href="/" class="px-4 py-2 text-sm font-medium text-gs-gray-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors">
          Inicio
        </a>
        <a href="/risk-scoring/" class="px-4 py-2 text-sm font-medium text-gs-gray-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors">
          Risk Scoring
        </a>
        <a href="/data-governance/" class="px-4 py-2 text-sm font-medium text-gs-gray-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors">
          Data Governance
        </a>
        <a href="/contract-ai/" class="px-4 py-2 text-sm font-medium text-gs-gray-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors">
          Contract AI
        </a>
      </nav>

      <!-- Huawei Cloud badge -->
      <div class="hidden sm:flex items-center space-x-2">
        <span class="text-xs text-gs-gray-300">Powered by</span>
        <span class="text-sm font-semibold text-gs-gold">Huawei Cloud</span>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-gs-gray-300 hover:text-white" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <a href="/" class="block px-3 py-2 text-sm text-gs-gray-300 hover:text-white hover:bg-white/10 rounded-lg">Inicio</a>
      <a href="/risk-scoring/" class="block px-3 py-2 text-sm text-gs-gray-300 hover:text-white hover:bg-white/10 rounded-lg">Risk Scoring</a>
      <a href="/data-governance/" class="block px-3 py-2 text-sm text-gs-gray-300 hover:text-white hover:bg-white/10 rounded-lg">Data Governance</a>
      <a href="/contract-ai/" class="block px-3 py-2 text-sm text-gs-gray-300 hover:text-white hover:bg-white/10 rounded-lg">Contract AI</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
