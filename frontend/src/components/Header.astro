---
export interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Inicio', id: 'home' },
  { href: '/risk-scoring/', label: 'Risk Scoring', id: 'risk-scoring' },
  { href: '/data-governance/', label: 'Data Governance', id: 'data-governance' },
  { href: '/contract-ai/', label: 'Contract AI', id: 'contract-ai' },
];
---

<header class="bg-gs-navy text-white sticky top-0 z-40 shadow-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3">
        <div class="flex items-center">
          <svg viewBox="0 0 40 40" class="w-9 h-9" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="20" cy="20" r="18" stroke="#C5A55A" stroke-width="2.5" fill="none"/>
            <text x="20" y="25" text-anchor="middle" fill="#C5A55A" font-family="Inter" font-weight="700" font-size="14">GS</text>
          </svg>
          <div class="ml-3">
            <div class="text-sm font-semibold text-gs-gold tracking-wide">GRUPO SALINAS</div>
            <div class="text-xs text-gs-gray-300 -mt-0.5">Aplicaciones y Cobranza</div>
          </div>
        </div>
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center space-x-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 text-sm font-medium rounded-lg transition-colors',
              currentPage === link.id
                ? 'text-white bg-white/10'
                : 'text-gs-gray-300 hover:text-white hover:bg-white/10',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Huawei Cloud badge -->
      <div class="hidden sm:flex items-center space-x-2">
        <span class="text-xs text-gs-gray-300">Powered by</span>
        <span class="text-sm font-semibold text-gs-gold">Huawei Cloud</span>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-gs-gray-300 hover:text-white" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            'block px-3 py-2 text-sm rounded-lg',
            currentPage === link.id
              ? 'text-white bg-white/10'
              : 'text-gs-gray-300 hover:text-white hover:bg-white/10',
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
