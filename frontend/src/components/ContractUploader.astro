---
// ContractUploader: drag & drop PDF upload with OCR pipeline trigger
---

<div id="uploader-zone" class="card p-8 border-2 border-dashed border-gs-gray-300 hover:border-gs-blue transition-colors cursor-pointer text-center">
  <div id="uploader-content">
    <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-gs-blue/10 flex items-center justify-center">
      <svg class="w-8 h-8 text-gs-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
      </svg>
    </div>
    <p class="text-lg font-semibold text-gs-navy mb-1">Arrastra un contrato PDF aquí</p>
    <p class="text-sm text-gs-gray-600">o haz clic para seleccionar archivo</p>
    <p class="text-xs text-gs-gray-400 mt-2">PDF · Máx 10MB</p>
    <div class="mt-3">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
        ⚠️ Simulación visual — Pipeline real vía OBS + FunctionGraph
      </span>
    </div>
  </div>

  <!-- Processing state (hidden by default) -->
  <div id="uploader-processing" class="hidden">
    <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-gs-blue/10 flex items-center justify-center animate-pulse-soft">
      <svg class="w-8 h-8 text-gs-blue animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
      </svg>
    </div>
    <p class="text-lg font-semibold text-gs-navy mb-1" id="processing-text">Procesando contrato...</p>
    <div class="w-48 h-2 bg-gs-gray-200 rounded-full mx-auto mt-3 overflow-hidden">
      <div id="progress-bar" class="h-full bg-gs-blue rounded-full transition-all duration-500" style="width: 0%"/>
    </div>
    <p class="text-xs text-gs-gray-500 mt-2" id="processing-step">Extrayendo texto con OCR...</p>
  </div>

    <!-- Result state (hidden by default) -->
  <div id="uploader-result" class="hidden">
    <div class="flex items-center justify-center space-x-6">
      <div id="result-gauge-container"></div>
      <div class="text-left">
        <p class="text-sm text-gs-gray-600">Contrato procesado</p>
        <p class="text-2xl font-bold text-gs-navy" id="result-contract-id">—</p>
        <div class="mt-2" id="result-badge"></div>
        <p class="text-xs text-gs-gray-500 mt-2" id="result-summary"></p>
        <p class="text-xs text-green-600 mt-1" id="result-status"></p>
        <ul id="result-alertas" class="hidden mt-2 space-y-1 list-disc list-inside"></ul>
      </div>
    </div>
    <div class="mt-4 flex items-center justify-center space-x-3">
      <button id="uploader-reset" class="text-sm text-gs-blue hover:underline">Analizar otro contrato</button>
      <span class="text-gs-gray-300">|</span>
      <button id="uploader-ask-dify" class="text-sm text-gs-navy hover:text-gs-blue font-semibold">
        Consultar en Dify Chat →
      </button>
    </div>
  </div>

  <input type="file" id="file-input" accept=".pdf" class="hidden" />
</div>

<script>
  const zone = document.getElementById('uploader-zone');
  const content = document.getElementById('uploader-content');
  const processing = document.getElementById('uploader-processing');
  const result = document.getElementById('uploader-result');
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const progressBar = document.getElementById('progress-bar');
  const processingStep = document.getElementById('processing-step');
  const resetBtn = document.getElementById('uploader-reset');
  const askDifyBtn = document.getElementById('uploader-ask-dify');

  // Drag & drop
  zone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    zone.classList.add('border-gs-blue', 'bg-gs-blue/5');
  });
  zone?.addEventListener('dragleave', () => {
    zone.classList.remove('border-gs-blue', 'bg-gs-blue/5');
  });
  zone?.addEventListener('drop', (e) => {
    e.preventDefault();
    zone.classList.remove('border-gs-blue', 'bg-gs-blue/5');
    const file = e.dataTransfer?.files[0];
    if (file?.type === 'application/pdf') handleFile(file);
  });
  zone?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', () => {
    if (fileInput.files?.[0]) handleFile(fileInput.files[0]);
  });
  resetBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showState('content');
  });

  // Ask Dify button: open chat widget with pre-filled query
  let lastFilename = '';
  askDifyBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    // Open chat widget if hidden
    const chatWindow = document.getElementById('chat-window');
    const chatInput = document.getElementById('chat-input') as HTMLInputElement;
    if (chatWindow?.classList.contains('chat-window-closed')) {
      document.getElementById('chat-toggle')?.click();
    }
    if (chatInput && lastFilename) {
      chatInput.value = `Analiza el contrato ${lastFilename.replace('.pdf', '')}`;
      chatInput.focus();
    }
  });

  function showState(state: string) {
    content?.classList.toggle('hidden', state !== 'content');
    processing?.classList.toggle('hidden', state !== 'processing');
    result?.classList.toggle('hidden', state !== 'result');
  }

  async function handleFile(file: File) {
    showState('processing');

    // Update badge to show real pipeline is running
    const badge = document.querySelector('#uploader-zone .inline-flex.items-center.px-2') as HTMLElement;
    if (badge) {
      badge.className = 'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800';
      badge.textContent = '🔵 Pipeline real — Subiendo a OBS + FunctionGraph';
    }

    const steps = [
      { text: 'Subiendo PDF a OBS...', pct: 15 },
      { text: 'Pipeline OCR disparado...', pct: 35 },
      { text: 'Extrayendo texto con OCR...', pct: 55 },
      { text: 'Analizando con DeepSeek v4 Flash...', pct: 75 },
      { text: 'Recuperando resultado...', pct: 90 },
    ];

    // Step 1: Upload PDF via API
    if (progressBar && processingStep) {
      progressBar.style.width = '15%';
      processingStep.textContent = 'Subiendo PDF a OBS...';
    }

    try {
      const formData = new FormData();
      formData.append('file', file);

      const uploadResp = await fetch('/api/upload', {
        method: 'POST',
        body: formData,
      });

      if (!uploadResp.ok) {
        const err = await uploadResp.json();
        throw new Error(err.detail || 'Error al subir el archivo');
      }

      const { job_id } = await uploadResp.json();
      lastFilename = file.name;

      // Step 2: Animate progress while polling
      for (let i = 1; i < steps.length; i++) {
        const step = steps[i];
        if (processingStep) processingStep.textContent = step.text;
        if (progressBar) progressBar.style.width = `${step.pct}%`;
        await new Promise(r => setTimeout(r, 1000));
      }

      // Step 3: Poll for results (up to 30s)
      if (processingStep) processingStep.textContent = 'Esperando resultado del análisis...';
      if (progressBar) progressBar.style.width = '92%';

      let resultData = null;
      for (let attempt = 0; attempt < 15; attempt++) {
        await new Promise(r => setTimeout(r, 2000));
        const statusResp = await fetch(`/api/status/${job_id}`);
        if (!statusResp.ok) continue;

        const status = await statusResp.json();
        if (status.status === 'completed') {
          resultData = status.result;
          break;
        }
      }

      if (progressBar) progressBar.style.width = '100%';

      if (resultData) {
        showResult(resultData, file.name);
      } else {
        // Timeout — show partial result with job_id
        showResult({
          risk_score: null,
          risk_level: 'PENDIENTE',
          contract_number: job_id,
          alertas: [],
          recomendaciones: [],
          resumen: 'El análisis está tomando más tiempo del esperado. Verifica el resultado en Dify Chat.',
          llm_provider: 'timeout',
        }, file.name);
      }
    } catch (err: any) {
      if (progressBar) progressBar.style.width = '0%';
      if (processingStep) processingStep.textContent = 'Error en el pipeline';
      showResult({
        risk_score: null,
        risk_level: 'ERROR',
        contract_number: file.name.replace('.pdf', ''),
        alertas: [err.message || 'Error desconocido'],
        recomendaciones: ['Verifica conectividad con OBS y FunctionGraph'],
        resumen: 'Error al procesar el contrato',
        llm_provider: 'error',
      }, file.name);
    }
  }

  function showResult(data: any, filename: string) {
    showState('result');

    const score = data.risk_score;
    const level = data.risk_level || (score !== null && score <= 3 ? 'BAJO' : score <= 5 ? 'MEDIO' : score <= 7 ? 'ALTO' : 'CRITICO');
    const isError = level === 'ERROR' || level === 'PENDIENTE';

    const container = document.getElementById('result-gauge-container');
    if (container) {
      const displayScore = score !== null ? score : 0;
      const color = isError ? '#6B7280' : displayScore < 4 ? '#00d4aa' : displayScore < 6 ? '#ffd700' : displayScore < 8 ? '#ff8c00' : '#ff4444';
      const label = isError ? level : displayScore < 4 ? 'Bajo' : displayScore < 6 ? 'Medio' : displayScore < 8 ? 'Alto' : 'Crítico';

      container.innerHTML = `
        <div class="relative" style="width: 100px; height: 100px">
          <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="40" fill="none" stroke="#E9ECEF" stroke-width="8"/>
            <circle cx="50" cy="50" r="40" fill="none" stroke="${color}" stroke-width="8"
              stroke-dasharray="${2 * Math.PI * 40}"
              stroke-dashoffset="${isError ? 2 * Math.PI * 40 : 2 * Math.PI * 40 - (displayScore / 10) * 2 * Math.PI * 40}"
              stroke-linecap="round"
              class="gauge-circle"
              style="filter: drop-shadow(0 0 6px ${color}40)"/>
          </svg>
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="text-2xl font-bold" style="color: ${color}">${isError ? '?' : displayScore.toFixed(1)}</span>
          </div>
        </div>
      `;
    }

    const contractId = document.getElementById('result-contract-id');
    if (contractId) contractId.textContent = data.contract_number || filename.replace('.pdf', '');

    const badge = document.getElementById('result-badge');
    if (badge) {
      const levelLabel = level === 'CRITICO' ? 'Crítico' : level === 'ALTO' ? 'Alto' : level === 'MEDIO' ? 'Medio' : level === 'BAJO' ? 'Bajo' : level;
      const isReal = !isError && score !== null;
      badge.innerHTML = `<span class="badge-risk-${level.toLowerCase()}">Riesgo ${levelLabel}</span>
        <span class="ml-2 text-xs ${isReal ? 'text-green-600' : 'text-gray-400'}">${isReal ? '● Pipeline real' : '● Sin resultado'}</span>`;
    }

    const summary = document.getElementById('result-summary');
    if (summary) {
      const providerText = data.llm_provider ? ` · ${data.llm_provider}` : '';
      summary.textContent = score !== null
        ? `Score: ${score.toFixed(1)}/10${providerText} · ${data.alertas?.length || 0} alertas`
        : `Resultado: ${level}${providerText}`;
    }

    // Show alertas if any
    const alertasDiv = document.getElementById('result-alertas');
    if (alertasDiv && data.alertas?.length) {
      alertasDiv.innerHTML = data.alertas.map((a: string) => `<li class="text-xs text-red-600">⚠ ${a}</li>`).join('');
      alertasDiv.classList.remove('hidden');
    }

    // Update Dify chat button text
    if (askDifyBtn) {
      askDifyBtn.textContent = 'Consultar en Dify Chat →';
    }
  }
</script>
