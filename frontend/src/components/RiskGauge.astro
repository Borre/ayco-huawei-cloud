---
export interface Props {
  score: number;       // 0-10
  label?: string;
  size?: 'sm' | 'md' | 'lg';
  animated?: boolean;
}

const { score, label = 'Riesgo', size = 'lg', animated = true } = Astro.props;

const sizes = {
  sm: { w: 120, stroke: 8, text: 'text-2xl' },
  md: { w: 180, stroke: 10, text: 'text-3xl' },
  lg: { w: 240, stroke: 12, text: 'text-5xl' },
};

const s = sizes[size];
const radius = (s.w - s.stroke * 2) / 2;
const circumference = 2 * Math.PI * radius;
const progress = (score / 10) * circumference;
const offset = circumference - progress;

function getColor(sc: number): string {
  if (sc < 4) return '#00d4aa';
  if (sc < 6) return '#ffd700';
  if (sc < 8) return '#ff8c00';
  return '#ff4444';
}

function getLabel(sc: number): string {
  if (sc < 4) return 'Bajo';
  if (sc < 6) return 'Medio';
  if (sc < 8) return 'Alto';
  return 'Crítico';
}

function getBadgeClass(sc: number): string {
  if (sc < 4) return 'badge-risk-low';
  if (sc < 6) return 'badge-risk-medium';
  if (sc < 8) return 'badge-risk-high';
  return 'badge-risk-critical';
}

const color = getColor(score);
const riskLabel = getLabel(score);
---

<div class="flex flex-col items-center">
  <div class="relative" style={`width: ${s.w}px; height: ${s.w}px`}>
    <svg class="w-full h-full -rotate-90" viewBox={`0 0 ${s.w} ${s.w}`}>
      <!-- Background circle -->
      <circle
        cx={s.w / 2}
        cy={s.w / 2}
        r={radius}
        fill="none"
        stroke="#1e2a3a"
        stroke-width={s.stroke}
        stroke-linecap="round"
      />
      <!-- Progress circle -->
      <circle
        class={animated ? 'gauge-circle' : ''}
        cx={s.w / 2}
        cy={s.w / 2}
        r={radius}
        fill="none"
        stroke={color}
        stroke-width={s.stroke}
        stroke-linecap="round"
        stroke-dasharray={circumference}
        stroke-dashoffset={animated ? circumference : offset}
        data-target-offset={offset}
        style={`filter: drop-shadow(0 0 6px ${color}40)`}
      />
    </svg>
    <!-- Score text -->
    <div class="absolute inset-0 flex flex-col items-center justify-center">
      <span class={`${s.text} font-bold tabular-nums`} style={`color: ${color}`}>
        {score.toFixed(1)}
      </span>
      <span class="text-xs text-gray-400 font-medium uppercase tracking-wider mt-1">
        {label}
      </span>
    </div>
  </div>
  <div class="mt-3">
    <span class={getBadgeClass(score)}>{riskLabel}</span>
  </div>
</div>

{animated && (
  <script>
    // Animate gauge on intersection
    const gaugeObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const circle = entry.target.querySelector('.gauge-circle');
          if (circle) {
            const target = circle.getAttribute('data-target-offset');
            setTimeout(() => {
              circle.style.strokeDashoffset = target;
            }, 200);
          }
          gaugeObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });

    document.querySelectorAll('.gauge-circle').forEach(el => {
      gaugeObserver.observe(el.closest('.relative') || el);
    });
  </script>
)}
