---
// Footer with Huawei Cloud ecosystem logos
---

<footer class="bg-gs-navy text-white mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center mb-4">
          <svg viewBox="0 0 40 40" class="w-8 h-8" fill="none">
            <circle cx="20" cy="20" r="18" stroke="#C5A55A" stroke-width="2" fill="none"/>
            <text x="20" y="25" text-anchor="middle" fill="#C5A55A" font-family="Inter" font-weight="700" font-size="14">HC</text>
          </svg>
          <span class="ml-2 text-sm font-semibold text-gs-gold">HUAWEI CLOUD</span>
        </div>
        <p class="text-sm text-gs-gray-300 leading-relaxed">
          Infraestructura cloud inteligente para América Latina. Potenciada por IA.
        </p>
      </div>

      <!-- Ecosystem -->
      <div>
        <h3 class="text-sm font-semibold text-gs-gold uppercase tracking-wider mb-4">Ecosistema</h3>
        <div class="grid grid-cols-2 gap-3">
          <span class="text-sm text-gs-gray-300">ECS</span>
          <span class="text-sm text-gs-gray-300">MaaS</span>
          <span class="text-sm text-gs-gray-300">DWS</span>
          <span class="text-sm text-gs-gray-300">DLI</span>
          <span class="text-sm text-gs-gray-300">OBS</span>
          <span class="text-sm text-gs-gray-300">FunctionGraph</span>
        </div>
      </div>

      <!-- Tech -->
      <div>
        <h3 class="text-sm font-semibold text-gs-gold uppercase tracking-wider mb-4">Tecnología</h3>
        <div class="space-y-2 text-sm text-gs-gray-300">
          <p>Huawei Cloud — la-north-2</p>
          <p>DeepSeek v4 Flash (MaaS)</p>
          <p>Dify · DLI · DWS · DataArts</p>
          <p>FunctionGraph · OBS · Langfuse</p>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 mt-8 pt-8 flex flex-col sm:flex-row items-center justify-between">
      <p class="text-xs text-gs-gray-300">
        © 2026 Huawei Cloud. Demo técnica — Huawei Cloud AI.
      </p>
      <p class="text-xs text-gray-400 mt-2 sm:mt-0">
        Demo Workshop 2026
      </p>
    </div>
  </div>
</footer>
