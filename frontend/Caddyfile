# AYCO Frontend — Grupo Salinas
# Deploy on ayco-web ECS (149.232.129.39)
# Caddy reverse proxy: static frontend + Dify API proxy

# Dify API proxy (avoids CORS, hides Dify IP)
https://ayco.demohub.mx/api/dify/* {
    reverse_proxy dify-internal:80 {
        header_up Host dify-internal
        rewrite * /v1{uri}
    }
}

# Frontend static site
https://ayco.demohub.mx {
    root * /var/www/ayco
    file_server
    try_files {path} {path}/ {path}/index.html

    # Cache static assets
    @static {
        path *.js *.css *.svg *.png *.jpg *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # SPA fallback
    handle_errors {
        @404 {
            expression {http.error.status_code} == 404
        }
        rewrite @404 /index.html
    }
}
