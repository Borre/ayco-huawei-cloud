# Huawei Cloud AI Frontend — Astro Build Environment Variables
# Copy to .env before building:
#   cp .env.example .env
#   npm install --legacy-peer-deps && npm run build

# REQUIRED: Dify API key for the chatbot widget
# App: "AI Chat" on Dify (http://101.44.185.139/chat/253ad7c8-1cd7-44ea-a27d-9d67f031e5a1)
# This is the key used in the Authorization header for all chat requests.
# The COBRANZA_KEY was removed from the auth flow — both Chat and Cobranza
# modes now use this same key (see AGENTS.md for why).
PUBLIC_DIFY_API_KEY=app-Y8MxfRygyUWOAfyTlo1MQSJx

# OPTIONAL: Cobranza agent key (currently unused by the frontend)
# The ChatWidget previously switched between DIFY_KEY and COBRANZA_KEY based on
# mode. Since both keys are Dify Chat app keys, only DIFY_KEY is used now.
# Set this if you re-implement dual-key auth.
# PUBLIC_COBRANZA_API_KEY=app-ZrM7Pal6G2b89drd1zLVssvM

# OPTIONAL: Streamlit dashboard URL
# Used by data-governance.astro to embed the iframe.
# PUBLIC_DASHBOARD_URL=http://101.44.185.139
