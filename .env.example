# AYCO Huawei Cloud — Environment Variables
# Copy to .env and fill in real values
# DO NOT commit .env with real credentials

# ─── Huawei Cloud ────────────────────────────────────────
HUAWEI_ACCESS_KEY=YOUR_AK_HERE
HUAWEI_SECRET_KEY=YOUR_SK_HERE
HUAWEI_REGION=la-north-2
HUAWEI_PROJECT_ID=YOUR_PROJECT_ID_HERE  # Get from Huawei Cloud console > My Credentials

# ─── SSH ─────────────────────────────────────────────────
SSH_KEYPAIR_NAME=hermes-agent
SSH_PRIVATE_KEY_PATH=~/.ssh/hermes-agent

# ─── MaaS API (Huawei-native LLM) ─────────────────────────
MAAS_API_KEY=YOUR_MAAS_KEY_HERE
MAAS_ENDPOINT=https://api-ap-southeast-1.modelarts-maas.com/v2/chat/completions

# ─── DeepSeek API (fallback) ──────────────────────────────
DEEPSEEK_API_KEY=***

# ─── Dify ────────────────────────────────────────────────
DIFY_BASE_URL=http://DIFY_IP_PLACEHOLDER/v1
DIFY_API_KEY=app-YOUR_DIFY_KEY_HERE
DIFY_ADMIN_EMAIL=admin@ayco-demo.local
DIFY_ADMIN_PASSWORD=CHANGE_ME

# ─── Langfuse (LLM Observability) ──────────────────────────
# From: https://cloud.langfuse.com → Project Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-YOUR_PUBLIC_KEY_HERE
LANGFUSE_SECRET_KEY=sk-lf-YOUR_SECRET_KEY_HERE
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── DWS ─────────────────────────────────────────────────
DWS_ADMIN_PASSWORD=CHANGE_ME_Str0ng!
TF_VAR_dws_database=ayco_db
