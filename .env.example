# AYCO Huawei Cloud — Environment Variables
# Copy to .env and fill in real values
# DO NOT commit .env with real credentials

# ─── Huawei Cloud ────────────────────────────────────────
HUAWEI_ACCESS_KEY=YOUR_AK_HERE
HUAWEI_SECRET_KEY=YOUR_SK_HERE
HUAWEI_REGION=la-north-2
HUAWEI_PROJECT_ID=fbb6435c497c41bda90a0cc5240573e0

# ─── SSH ─────────────────────────────────────────────────
SSH_KEYPAIR_NAME=hermes-agent
SSH_PRIVATE_KEY_PATH=~/.ssh/hermes-agent

# ─── DeepSeek API ────────────────────────────────────────
DEEPSEEK_API_KEY=sk-YOUR_KEY_HERE

# ─── Dify ────────────────────────────────────────────────
DIFY_BASE_URL=http://DIFY_IP_PLACEHOLDER/v1
DIFY_API_KEY=app-YOUR_DIFY_KEY_HERE
DIFY_ADMIN_EMAIL=admin@ayco-demo.local
DIFY_ADMIN_PASSWORD=CHANGE_ME

# ─── DWS ─────────────────────────────────────────────────
DWS_ADMIN_PASSWORD=CHANGE_ME_Str0ng!
